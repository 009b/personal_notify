# Telegram
BOT_TOKEN=your_bot_token_here
ALLOWED_USER_ID=your_telegram_user_id

# App
LOG_LEVEL=INFO
DEBUG=false

# Weather provider
GISMETEO_TOKEN=your_gismeteo_token

# Telegram userbot (Telethon) — чтение каналов для новостного дайджеста
# Получить на https://my.telegram.org
TG_API_ID=your_api_id
TG_API_HASH=your_api_hash
# TG_SESSION_PATH=data/userbot.session

# Ollama (optional override of config.yaml)
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Config
# CONFIG_PATH=config.yaml
